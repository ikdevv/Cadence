enum Role {
  MEMBER
  MANAGER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  /// Exposed in URLs and API responses instead of `id`. Generated at creation,
  /// independent of `id` — never derived from it, a hash of it, or from email/name.
  publicId     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  invitationsSent Invitation[]   @relation("InvitedBy")
  reports         Report[]
  reviewsGiven    ReviewAction[] @relation("reviewer")

  @@index([role, isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
