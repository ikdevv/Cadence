@baseUrl = http://localhost:3001
@email = alice@example.com
@password = Password123

### Register
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Alice"
}

### Register — duplicate email (expect 409 Conflict)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Alice"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login — wrong password (expect 401 Unauthorized)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

### Current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### Current user — no token (expect 401 Unauthorized)
GET {{baseUrl}}/auth/me

### Refresh — rotates the refresh token, returns a new pair
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Refresh — reusing an already-rotated token (expect 401 Unauthorized)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Logout — revokes the refresh token
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refresh.response.body.$.refreshToken}}"
}
